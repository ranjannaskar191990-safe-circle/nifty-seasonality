generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PotentialBreakout {
  id               Int      @id @default(autoincrement())
  symbol           String
  companyName      String
  currentPrice     Float
  highPrice        Float    // The breakout resistance level
  distanceFromHigh Float 
  baseLengthMonths Int      
  volumeSurge      Float    // Volume multiplier
  scannedAt        DateTime @default(now())
}