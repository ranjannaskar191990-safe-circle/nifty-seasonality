generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Stores only the stocks that are ready to breakout
model PotentialBreakout {
  id           Int      @id @default(autoincrement())
  symbol       String
  companyName  String
  currentPrice Float
  distanceFromHigh Float // How far from the ATH
  scannedAt    DateTime @default(now())
}