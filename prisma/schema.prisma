model Portfolio {
  id              String   @id @default(uuid())
  userId          String
  symbol          String
  targetMonth     Int
  requiredCapital Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TradeJournal {
  id              String    @id @default(uuid())
  userId          String
  symbol          String
  tradeMonth      String
  noTradeGapMet   Boolean
  gttStopPlaced   Boolean
  earningsCleared Boolean
  entryDate       DateTime
  entryPrice      Float
  exitDate        DateTime?
  exitPrice       Float?
  allocatedAmount Float
  netPnL          Float?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}