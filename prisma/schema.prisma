generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Existing Tables ---

model Portfolio {
  id              String   @id @default(uuid())
  userId          String
  symbol          String
  targetMonth     Int
  requiredCapital Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TradeJournal {
  id              String    @id @default(uuid())
  userId          String
  symbol          String
  tradeMonth      String
  noTradeGapMet   Boolean
  gttStopPlaced   Boolean
  earningsCleared Boolean
  entryDate       DateTime
  entryPrice      Float
  exitDate        DateTime?
  exitPrice       Float?
  allocatedAmount Float
  netPnL          Float?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// --- Scanner Tables ---

model MultiYearBreakout {
  id            String   @id @default(cuid())
  symbol        String   @unique
  companyName   String
  cmp           Float
  fiveYearHigh  Float
  distancePerc  Float
  volumeRatio   Float
  volume20SMA   BigInt
  lastScannedAt DateTime @default(now())
}

model ScanLog {
  id      Int      @id @default(autoincrement())
  lastRun DateTime @default(now())
}