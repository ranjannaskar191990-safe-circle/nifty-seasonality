generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PotentialBreakout {
  id               Int      @id @default(autoincrement())
  symbol           String
  companyName      String
  currentPrice     Float
  distanceFromHigh Float 
  baseLengthMonths Int      // Added this line to store the base size
  scannedAt        DateTime @default(now())
}